{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2022", "DOM.Iterable", "ESNext.Disposable"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "cm-bundle:*": ["./node_modules/*"],
      "src/*": ["modules/obsidian-git/src/*"],
      "@/*": ["modules/music-player/src/*"],
      "buffer-polyfill": ["modules/music-player/node_modules/buffer"],
      "@core/*": ["modules/scrolling/src/core/*"],
      "@features/*": ["modules/scrolling/src/features/*"],
      "@typings/*": ["modules/scrolling/src/typings/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": ["src/**/*.ts", "modules/logseq/src/**/*.ts", "modules/browser/src/**/*.ts", "modules/jupyter/src/**/*.ts", "modules/breadcrumb/src/**/*.ts", "modules/doc-assist/src/**/*.ts", "modules/material-icon-theme/src/**/*.ts", "modules/tracetime/src/**/*.ts", "modules/ai-image-analyzer/src/**/*.ts", "modules/omnisearch/src/**/*.ts", "modules/obsidian-git/src/**/*.ts", "modules/open-tab-settings/src/**/*.ts", "modules/audio-recorder/src/**/*.ts", "modules/media-journal/src/**/*.ts", "modules/music-player/src/**/*.ts", "modules/music-player/src/**/*.tsx", "modules/audio-player/src/**/*.ts", "modules/scrolling/src/**/*.ts"],
  "exclude": ["**/node_modules", "**/tests/e2e", "modules/omnisearch/src/__tests__", "modules/ai-image-analyzer/src", "modules/obsidian-git/tests", "modules/obsidian-git/src/__tests__"]
}
