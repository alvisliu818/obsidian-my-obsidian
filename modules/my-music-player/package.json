{
	"name": "obsidian-music-player-plugin",
	"version": "1.3.8",
	"description": "Play local music files from the vault in the sidebar.",
	"main": "main.js",
	"type": "module",
	"author": "Kevin",
	"repository": {
		"type": "git",
		"url": "https://github.com/TracingOrigins/obsidian-music-player-plugin.git"
	},
	"scripts": {
		"dev": "node scripts/deploy.mjs dev && node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/deploy.mjs build",
		"version": "node version-bump.mjs && git add package.json manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"Music",
		"Music Player",
		"Obsidian Plugin"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"@typescript-eslint/utils": "^8.54.0",
		"buffer": "^6.0.3",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"events": "^3.3.0",
		"globals": "^17.6.0",
		"music-metadata": "^12.2.2",
		"process": "^0.11.10",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"obsidian": "1.14.4"
	},
	"overrides": {
		"moment": "^2.31.0",
		"brace-expansion": "^2.1.7",
		"fast-uri": "^3.1.8",
		"js-yaml": "^5.5.0",
		"file-type": "^22.2.0"
	},
	"allowScripts": {
		"esbuild": true
	}
}
