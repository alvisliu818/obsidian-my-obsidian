    "@fullcalendar/luxon3": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "d3": "^7.9.0",
    "luxon": "^3.7.2",
    "moment": "^2.31.0",
    "obsidian-calendar-ui": "0.3.12",
    "obsidian-daily-notes-interface": "0.9.5",
    "svelte": "^4.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@types/moment": "^2.13.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/parser": "^8.62.0",
    "esbuild": "0.20.0",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.6.0",
