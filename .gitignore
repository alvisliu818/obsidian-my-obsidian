node_modules/
main.js
# 聚合宿主 build 的副产物(esbuild 每次 build 都生成在仓库根,不部署、不入库)
main.css
styles.css.map
*.log
.workbuddy/
test-results/
coverage/
# 本地 e2e 探针脚本（沿用各插件的约定：下划线开头的不入库）
tests/e2e/_*.mjs
# Material Icon Theme 的图标数据由 scripts/build-icons.mjs 生成（约 2MB
# 内联 SVG），跟随上游做法不入库，构建前生成。
modules/material-icon-theme/src/icon-data.ts
# e2e 截图与一次性脚本（下划线开头 = 本地探针，沿用各插件约定）
tests/e2e/_*.png
tests/e2e/_*.sh
# logseq 模块的本地探针转储 / 夹具内可再生产物
modules/logseq/tests/_ins-*.txt
modules/logseq/tests/_new-*.ts.txt
modules/logseq/tests/_diag-*
modules/logseq/tests/fixtures/edge-vault/.obsidian/plugins/obsidian-logseq/monaco.css
modules/logseq/tests/fixtures/edge-vault/.obsidian/plugins/obsidian-logseq/monaco-workers/
# 各模块的一次性探针脚本(下划线开头,含 e2e 子目录)
modules/*/tests/**/_probe-*.mjs

# ts 增量构建信息(各模块 tsconfig.tsbuildinfo)
*.tsbuildinfo

# e2e 探针输出日志（重定向 .out，配合 _*.mjs 探针）
tests/e2e/_*.out

# 仓库根的一次性诊断/插桩脚本（下划线开头不入库）
/_ins-*.mjs
/_probe-*.mjs
/_diag-*
