{
  "name": "obsidian-my-obsidian",
  "version": "0.1.0",
  "description": "One plugin bundling the author's Obsidian add-ons: Logseq block editor, Browser, Jupyter Notebook, Breadcrumb Nav, Doc Assist, Material Icon Theme, TraceTime, Git, AI image analyzer, Omnisearch, Save Control, Open Tab Settings and Advanced Audio Recorder — each switchable from the settings.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.mjs",
    "build:icons": "node modules/material-icon-theme/scripts/build-icons.mjs",
    "build": "npm run build:icons && tsc -noEmit -skipLibCheck && node esbuild.mjs production",
    "build:fast": "node esbuild.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run --root modules/logseq",
    "test:audio-player": "vitest run --root modules/audio-player",
    "test:watch": "vitest --root modules/logseq",
    "test:breadcrumb": "cd modules/breadcrumb && npm run test",
    "test:doc-assist": "cd modules/doc-assist && npm test",
    "test:icons": "cd modules/material-icon-theme && npm test",
    "test:omnisearch": "cd modules/omnisearch && npx vitest run",
    "test:audio-recorder": "cd modules/audio-recorder && npm test",
    "e2e:merge": "node tests/e2e/_merge-smoke.mjs",
    "e2e": "playwright test -c modules/logseq/tests/e2e/playwright.config.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "logseq",
    "browser",
    "jupyter",
    "breadcrumb",
    "doc-assist",
    "material-icons",
    "time-tracking",
    "git",
    "audio-recorder",
    "transcription"
  ],
  "author": "alvisliu",
  "authorUrl": "https://github.com/alvisliu818",
  "license": "GPL-3.0",
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
