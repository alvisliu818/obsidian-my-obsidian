{
  "name": "obsidian-my-obsidian",
  "version": "0.1.0",
  "description": "One plugin bundling the author's Obsidian add-ons: Logseq block editor, Browser, Jupyter Notebook and Breadcrumb Nav — each switchable from the settings.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.mjs production",
    "build:fast": "node esbuild.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run --root modules/logseq",
    "test:watch": "vitest --root modules/logseq",
    "test:breadcrumb": "cd modules/breadcrumb && npm run test",
    "e2e:merge": "node tests/e2e/_merge-smoke.mjs",
    "e2e": "playwright test -c modules/logseq/tests/e2e/playwright.config.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "logseq",
    "browser",
    "jupyter",
    "breadcrumb"
  ],
  "author": "alvisliu",
  "authorUrl": "https://github.com/alvisliu818",
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.2",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.1",
    "@mozilla/readability": "^0.5.0",
    "@types/prismjs": "^1.26.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "node-pty": "^1.1.0",
    "prismjs": "^1.30.0",
    "turndown": "^7.2.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "wa-sqlite": "^1.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.48",
    "@types/node": "^20.19.43",
    "@types/turndown": "^5.0.5",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "obsidian": "^1.5.7",
    "pyright": "^1.1.414",
    "tslib": "^2.6.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
