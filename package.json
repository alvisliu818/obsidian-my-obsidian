{
  "name": "obsidian-my-obsidian",
  "version": "0.1.0",
  "description": "One plugin bundling the author's Obsidian add-ons: Logseq block editor, Browser, Jupyter Notebook, Breadcrumb Nav, Doc Assist, Material Icon Theme, TraceTime, Git, AI image analyzer, Omnisearch, Save Control, Open Tab Settings, Advanced Audio Recorder, Vault Explorer and Code Link — each switchable from the settings.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.mjs",
    "build:icons": "node modules/material-icon-theme/scripts/build-icons.mjs",
    "build": "yarn node scripts/build-parallel.mjs",
    "build:fast": "node esbuild.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck -incremental -tsBuildInfoFile .cache/tsc-noemit.tsbuildinfo",
    "test": "vitest run --root modules/virtual-tree && vitest run --root modules/browser && vitest run --root modules/code-editor && vitest run --root modules/logseq && vitest run --root modules/abstract-folder && vitest run --root modules/latex-delimiter-renderer && vitest run --root modules/omnisearch && vitest run --root modules/save-control && vitest run --root modules/code-link && node scripts/test-index-core.mjs",
    "test:index-core": "node scripts/test-index-core.mjs",
    "test:audio-player": "vitest run --root modules/audio-player",
    "test:abstract-folder": "vitest run --root modules/abstract-folder",
    "test:code-link": "vitest run --root modules/code-link",
    "test:watch": "vitest --root modules/logseq",
    "test:breadcrumb": "cd modules/breadcrumb && node esbuild.config.mjs production && node tests/smoke.cjs",
    "test:doc-assist": "cd modules/doc-assist && mkdir -p node_modules/.cache && tsc -noEmit -skipLibCheck && esbuild tests/smoke-core.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke.cjs --log-level=warning && node node_modules/.cache/smoke.cjs",
    "test:icons": "cd modules/material-icon-theme && node --test tests/*.test.mjs",
    "test:omnisearch": "vitest run --root modules/omnisearch",
    "test:audio-recorder": "cd modules/audio-recorder && jest",
    "e2e:merge": "node tests/e2e/_merge-smoke.mjs",
    "e2e": "playwright test -c modules/logseq/tests/e2e/playwright.config.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "logseq",
    "browser",
    "jupyter",
    "breadcrumb",
    "doc-assist",
    "material-icons",
    "time-tracking",
    "git",
    "audio-recorder",
    "transcription",
    "code-link"
  ],
